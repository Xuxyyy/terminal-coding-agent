{
  "name": "terminal-coding-agent",
  "version": "0.1.0",
  "private": true,
  "description": "acc — a small terminal coding agent that reads, edits, and runs code in the current directory.",
  "license": "MIT",
  "author": "Xuxyyy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuxyyy/terminal-coding-agent.git"
  },
  "homepage": "https://coding-cli-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Xuxyyy/terminal-coding-agent/issues"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "llm",
    "terminal",
    "ink",
    "deepseek",
    "kimi",
    "glm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
