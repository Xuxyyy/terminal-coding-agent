{
  "name": "terminal-coding-agent",
  "version": "0.1.0",
  "private": true,
  "description": "acc \u2014 a small terminal coding agent that reads, edits, and runs code in the current directory.",
  "license": "MIT",
  "author": "Xuxyyy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuxyyy/terminal-coding-agent.git"
  },
  "homepage": "https://github.com/Xuxyyy/terminal-coding-agent/tree/main/docs",
  "bugs": {
    "url": "https://github.com/Xuxyyy/terminal-coding-agent/issues"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "llm",
    "terminal",
    "ink",
    "deepseek"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "acc": "dist/cli.js"
  },
  "scripts": {
    "clean": "node --eval \"import {rmSync} from 'node:fs'; rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc && node src/build/embed-system-prompt.mjs && node src/build/source-version.mjs",
    "prepare": "npm run build",
    "dev": "npm run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "test": "npm run build && node --import ./dist/tests/offline.js --test \"dist/**/*.test.js\"",
    "eval:judge": "npm run build && node dist/evals/judge/run.js",
    "eval:operational": "npm run build && node dist/evals/operational/run.js",
    "eval:standard": "npm run build && node dist/evals/standard/run.js"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "marked": "^14.0.0",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
