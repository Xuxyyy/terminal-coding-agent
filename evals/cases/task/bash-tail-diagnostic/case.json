{
  "id": "bash-tail-diagnostic",
  "suite": "focused",
  "category": "recover",
  "task": {
    "prompt": "`npm test` fails after producing a large amount of output. Use the retained diagnostic to fix the configuration, then run `npm test` successfully. Do not change the checker or project scripts.",
    "mode": "auto-edits",
    "policy": "yes",
    "maxSeconds": 120
  },
  "grade": {
    "allowedWrites": [
      "config/settings.js"
    ],
    "checks": [
      {
        "kind": "exit0",
        "command": "npm test"
      },
      {
        "kind": "tool",
        "name": "bash",
        "argsPattern": "npm test",
        "resultPattern": "^\\[exit 0\\]"
      },
      {
        "kind": "matches",
        "path": "config/settings.js",
        "pattern": "retries\\s*:\\s*3"
      },
      {
        "kind": "unchanged",
        "path": "scripts/check-config.js"
      },
      {
        "kind": "unchanged",
        "path": "package.json"
      }
    ]
  }
}
