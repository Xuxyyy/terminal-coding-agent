# Copy this file to .env and fill in the key for the provider you use.
# acc reads .env in the current directory, then ~/.acc/.env.
# One key is enough; acc picks a model from whichever key it finds.

# DeepSeek — https://platform.deepseek.com
# Provides deepseek-v4-flash (the default model) and deepseek-v4-pro.
DEEPSEEK_API_KEY=

# GLM / Z.ai — https://z.ai
# Provides glm-5.2 and glm-4.7-flash.
GLM_API_KEY=

# Moonshot / Kimi — https://platform.moonshot.ai
# Provides kimi-k3 and kimi-k2.7-code.
MOONSHOT_API_KEY=

# Optional: force one model instead of letting acc choose.
# ACC_MODEL=deepseek-v4-flash
